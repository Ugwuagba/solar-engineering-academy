generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── RBAC Enums ───────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  PROGRAM_ADMIN
  INSTRUCTOR
  LEARNER
  LP_EDITOR
  /// Legacy aliases kept for backward-compatibility with existing data rows.
  /// @deprecated Use SUPER_ADMIN or PROGRAM_ADMIN instead of ADMIN.
  ADMIN
  /// @deprecated Use LEARNER instead of STUDENT.
  STUDENT
}

enum CourseStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  REVISION_REQUESTED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id               String           @id @default(cuid())
  name             String?
  email            String           @unique
  passwordHash     String
  role             Role             @default(LEARNER)
  isEmailVerified  Boolean          @default(false)
  resetToken       String?          @unique
  resetTokenExpiry DateTime?
  enrollments      Enrollment[]
  payments         Payment[]
  certificates     Certificate[]
  quizAttempts     QuizAttempt[]
  lessonProgresses LessonProgress[]
  auditLogs        AuditLog[]
  courses          Course[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Course {
  id             String        @id @default(cuid())
  code           String        @unique
  title          String
  slug           String        @unique
  subtitle       String?
  description    String
  level          String        @default("INTRODUCTORY") // INTRODUCTORY, INTERMEDIATE, ADVANCED, COMPREHENSIVE_MASTERCLASS
  deliveryType   String        @default("SELF_PACED") // SELF_PACED, COHORT
  contactHours   Int
  price          Float
  originalPrice  Float?
  isPublished    Boolean       @default(false)
  status         CourseStatus  @default(DRAFT)
  instructorId   String?
  instructor     User?         @relation(fields: [instructorId], references: [id])
  instructorName String?       @default("Engr. Asanga")
  whatYoullLearn String?       @default("[]") // JSON string array
  includesList   String?       @default("[]") // JSON string array
  targetAudience String[]      @default([])
  requirements   String[]      @default([])
  thumbnailUrl   String?
  promoVideoUrl  String?
  badge          String?
  order          Int           @default(0)
  modules        Module[]
  cohorts        Cohort[]
  enrollments    Enrollment[]
  payments       Payment[]
  certificates   Certificate[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Cohort {
  id          String       @id @default(cuid())
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name        String
  startDate   DateTime
  endDate     DateTime
  maxCapacity Int          @default(30)
  enrollments Enrollment[]
  createdAt   DateTime     @default(now())
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  sortOrder   Int      @default(0)
  description String?
  lessons     Lesson[]
  quiz        Quiz?
  createdAt   DateTime @default(now())
}

model Lesson {
  id                String           @id @default(cuid())
  moduleId          String
  module            Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title             String
  sortOrder         Int              @default(0)
  videoUrl          String?
  durationText      String?
  durationSec       Int              @default(0)
  contentMarkdown   String           @default("")
  downloadableUrl   String?
  technicalSheetUrl String?
  isFreePreview     Boolean          @default(false)
  progresses        Progress[]
  lessonProgresses  LessonProgress[]
  createdAt         DateTime         @default(now())
}

model Quiz {
  id           String        @id @default(cuid())
  moduleId     String        @unique
  module       Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title        String
  passingScore Int           @default(70)
  questions    Question[]
  attempts     QuizAttempt[]
  createdAt    DateTime      @default(now())
}

model Question {
  id                 String   @id @default(cuid())
  quizId             String
  quiz               Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text               String
  optionsJson        String
  correctOptionIndex Int
  explanation        String
  createdAt          DateTime @default(now())
}

model Enrollment {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  cohortId        String?
  cohort          Cohort?    @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  status          String     @default("ACTIVE") // ACTIVE, COMPLETED
  progressPercent Float      @default(0)
  amountPaid      Float?
  progresses      Progress[]
  enrolledAt      DateTime   @default(now())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([userId, courseId])
}

model Progress {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  watchedSec   Int        @default(0)
  isCompleted  Boolean    @default(false)
  updatedAt    DateTime   @updatedAt

  @@unique([enrollmentId, lessonId])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score       Float
  passed      Boolean
  attemptedAt DateTime @default(now())
}

model Certificate {
  id              String   @id @default(cuid())
  certificateCode String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  contactHours    Int
  issuedAt        DateTime @default(now())
  pdfUrl          String?
}

model OtpVerification {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model LessonProgress {
  id           String   @id @default(cuid())
  userId       String
  lessonId     String
  courseId     String
  completed    Boolean  @default(false)
  lastPosition Int      @default(0) // timestamp in seconds
  updatedAt    DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, courseId])
}

// ─── Audit / Governance ───────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String // e.g. "PUBLISH_COURSE", "CHANGE_ROLE", "APPROVE_ENROLLMENT"
  resource  String // e.g. "Course:clxyz123", "User:clxyz456"
  details   Json // freeform metadata snapshot

  @@index([actorId])
  @@index([timestamp])
}

// ─── Financial / Payments ─────────────────────────────────────────────────────

model Payment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  amount    Float
  status    String   @default("COMPLETED")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([courseId])
}

// ─── Landing Page CMS ─────────────────────────────────────────────────────────

model LandingPage {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  isPublished      Boolean  @default(true)
  showPlaceholders Boolean  @default(false)
  whatsappUrl      String
  metaPixelId      String?
  content          Json
  media            Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([slug])
  @@index([isPublished])
}

model LandingPageMedia {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  sizeBytes Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─── Newsletter Subscribers ───────────────────────────────────────────────────

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
