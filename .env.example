# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/solar_academy?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-32-character-random-secret-key"

# SMTP Email Configuration (Subway Schools Official Mail)
SMTP_HOST="mail.subwayschools.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="admissions@subwayschools.com"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="Subway Schools <admissions@subwayschools.com>"

# Optional Fallback: Resend Email Configuration
RESEND_API_KEY="your-resend-api-key"
